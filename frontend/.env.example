# Copiar este archivo como .env y completar los valores
# El .env NO se sube al repositorio (está en .gitignore)

# URL del backend Spring Boot
# En emulador Android: 10.0.2.2 apunta a localhost de tu PC
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Si corrés en dispositivo físico, reemplazar con la IP local de tu PC
# Ejemplo: EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
